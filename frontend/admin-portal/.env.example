# Delta SPMU — Admin Portal env vars
# Copy to .env.local for local dev. In Vercel set these under
# Project Settings → Environment Variables.

# Frappe backend API base URL.
VITE_API_URL=https://api.deltaspmu.com

# When true, the admin portal proxies all Vimeo calls through the Frappe
# backend (lms.lms.vimeo_api.*) instead of hitting Vimeo directly. Required
# in production so the Vimeo access token never reaches the browser.
VITE_USE_VIMEO_PROXY=true

# Direct Vimeo access token — ONLY for local development (when
# VITE_USE_VIMEO_PROXY=false). Never set this in Vercel for the deployed
# admin portal; use the proxy instead.
VITE_VIMEO_ACCESS_TOKEN=

# Email Lambda API Gateway URL — see infrastructure/email.tf for the
# resource that produces this URL (terraform output email_api_url).
VITE_EMAIL_API_URL=

# API key for the email Lambda — pulled from SSM Parameter Store
# /deltaspmu/email-api-key (see infrastructure/email.tf).
VITE_EMAIL_API_KEY=
