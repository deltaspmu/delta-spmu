{
  "build": {
    "env": {
      "VITE_API_URL": "",
      "VITE_USE_VIMEO_PROXY": "true"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.deltaspmu.com/api/:path*" },
    { "source": "/files/:path*", "destination": "https://api.deltaspmu.com/files/:path*" },
    { "source": "/private/:path*", "destination": "https://api.deltaspmu.com/private/:path*" },
    { "source": "/((?!api|files|private).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
