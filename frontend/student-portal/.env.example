# Delta SPMU — Student Portal env vars
# Copy to .env.local for local dev. In Vercel set these under
# Project Settings → Environment Variables.

# Frappe backend API base URL. The Vite dev proxy (see vite.config.ts) forwards
# /api and /files to this host; in production the Axios client uses it directly.
VITE_API_URL=https://api.deltaspmu.com

# Frappe Desk URL (used by AuthContext to redirect admins to the Desk after
# login). Usually identical to VITE_API_URL.
VITE_FRAPPE_DESK_URL=https://api.deltaspmu.com

# When true, admin users do NOT get redirected to Frappe Desk after login
# (handy when developing the admin portal locally with an admin account).
VITE_SKIP_ADMIN_REDIRECT=false

# Google Analytics 4 measurement ID. Leave blank to disable analytics —
# initGA() and trackPageView() become no-ops.
VITE_GA_MEASUREMENT_ID=

# Maintenance mode flag — when true the app renders a "down for maintenance"
# splash instead of routing. Currently consulted only in App.tsx (TODO).
VITE_MAINTENANCE_MODE=false
